# Kopier til .env og fyll inn. Aldri legg ekte hemmeligheter i repoet.

# Postgres. Appen skal bruke en rolle uten SUPERUSER/BYPASSRLS (faktura_app i docker/init-db.sql).
DATABASE_URL=postgres://faktura_app:faktura_app@localhost:5432/faktura
# Migreringer kjøres som eier-rollen. Utelates den, brukes DATABASE_URL.
DATABASE_MIGRATION_URL=postgres://faktura_owner:faktura_owner@localhost:5432/faktura

# Minst 32 tilfeldige tegn. Brukes til kryptering av tofaktor-nøkler og engangskoder.
# Lag en med: openssl rand -base64 48
APP_SECRET=

# Offentlig adresse (brukes i e-poster og Origin-sjekk)
APP_URL=http://localhost:3000

# E-post (SMTP). Tom verdi = meldinger blir liggende i utboksen.
SMTP_URL=
EMAIL_FROM=Fakturasystem <ikke-svar@example.no>

# Bare i testmiljøet. Appen nekter å starte med testmodus i produksjon uten en database
# som er merket som testdatabase (npm run db:mark-test).
FAKTURA_TEST_MODE=false
